# CuteCart Server Environment Variables (M2: Database, Search, Background Jobs)
# Copy this file to .env for local development. NEVER commit .env or real secrets.

NODE_ENV=development
PORT=5000

# Migrator / Admin PostgreSQL connection (used ONLY for running migrations & seeds)
DATABASE_URL=postgresql://cutecart_migrator:cutecart_dev_password@127.0.0.1:5432/cutecart

# Least-privilege application runtime connection (subject to RLS, NOBYPASSRLS)
APP_DATABASE_URL=postgresql://cutecart_app:cutecart_app_dev_password@127.0.0.1:5432/cutecart

# Read-only reporting connection (SELECT only, subject to RLS)
READONLY_DATABASE_URL=postgresql://cutecart_readonly:cutecart_readonly_dev_password@127.0.0.1:5432/cutecart

# Passwords provisioned for least-privilege roles during migration 003 (override in staging/prod)
APP_DB_ROLE_PASSWORD=cutecart_app_dev_password
READONLY_DB_ROLE_PASSWORD=cutecart_readonly_dev_password

# PostgreSQL connection pool tuning (T2.5)
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_SSL=false

# Background job queue (pg-boss on PostgreSQL, no Redis)
PGBOSS_SCHEMA=pgboss
PGBOSS_RETRY_LIMIT=3
PGBOSS_RETRY_DELAY_SECONDS=30

# Legacy MongoDB user migration (T2.7 - optional, remove after migration completes)
LEGACY_MONGODB_URL=
LEGACY_MONGODB_DB=auth_welab
LEGACY_USERS_JSON_PATH=
